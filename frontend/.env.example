# Only needed when the admin panel is hosted on a different origin than the backend (the dev server proxies
# /api to localhost:4000 itself - see vite.config.ts - so this is unused locally).
# Build-time only (Vite inlines it): set it in your hosting provider's build environment, then run `npm run build`.
VITE_API_BASE_URL=https://api.example.com/api/v1
