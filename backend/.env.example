NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postal_admin?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

GEOCODING_PROVIDER=google
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim rejects placeholder-looking identifiers (e.g. an "example.com"
# contact) with "Access denied" — use a real app name/domain in production.
NOMINATIM_USER_AGENT=PostalDeliveryOpsSystem-BhandupWest/1.0
# Required when GEOCODING_PROVIDER=google. Enable the "Geocoding API" on this
# key in Google Cloud Console.
GOOGLE_GEOCODING_API_KEY=

CORS_ORIGIN=http://localhost:5173
