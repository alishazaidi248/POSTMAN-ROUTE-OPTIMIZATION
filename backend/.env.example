NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postal_admin?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# nominatim | google | none (none: no external geocoder; the beat list assigns by name and the rest go to exceptions)
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim rejects placeholder-looking identifiers (e.g. an "example.com"
# contact) with "Access denied" — use a real app name/domain in production.
NOMINATIM_USER_AGENT=PostalDeliveryOpsSystem-BhandupWest/1.0
# Required when GEOCODING_PROVIDER=google. Enable the "Geocoding API" on this
# key in Google Cloud Console.
GOOGLE_GEOCODING_API_KEY=

CORS_ORIGIN=http://localhost:5173

# --- Route optimization -------------------------------------------------
# Road routing engine (OSRM-compatible). Used for the travel-time/distance
# matrix and the road polyline shown on the postman's map. Leave empty to
# disable it: the optimizer then uses straight-line estimates and the route
# response is flagged "ESTIMATED" so the app can say so.
#
# The public demo server below is for development only (fair-use, driving
# profile, no uptime guarantee) and it receives delivery coordinates — for
# production self-host OSRM (https://github.com/Project-OSRM/osrm-backend)
# and point this at it.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=8000

# The route algorithm is fixed: DBSCAN -> Nearest Neighbor -> 2-opt -> ALNS over the road
# travel-time matrix. It is not an option and cannot be chosen by a client. These only
# tune it:
# DBSCAN: two stops are neighbours when the road travel time between them is at most
# EPS seconds; leave EPS empty/0 to derive it from each route's own travel times. A
# cluster needs at least MIN_POINTS stops (itself included).
ROUTE_DBSCAN_EPS_SECONDS=
ROUTE_DBSCAN_MIN_POINTS=2
# A GPS fix / last known location farther than this from the post office is not used
# as the start of the round (the post office is, and the route says so).
ROUTE_START_MAX_KM=50
# ALNS, the last stage of the route pipeline (DBSCAN -> NN -> 2-opt -> ALNS). It cannot be switched off or
# replaced; these only bound how long it searches. A route is returned as soon as one limit is reached.
ROUTE_ALNS_MAX_ITERATIONS=2500
ROUTE_ALNS_MAX_MS=1500
ROUTE_ALNS_NO_IMPROVEMENT_LIMIT=600
# true: every DBSCAN cluster stays one unbroken run in the final route (the design intent of clustering).
# false: ALNS may also move a stop into another cluster when that lowers the cost.
ROUTE_ALNS_PRESERVE_CLUSTERS=true
# 2-opt safety limits so a large route can never block the API process.
ROUTE_2OPT_MAX_MS=1500
ROUTE_2OPT_MAX_PASSES=500
# Used for ETAs when a delivery has no serviceTimeMinutes of its own.
DEFAULT_SERVICE_TIME_MINUTES=3
